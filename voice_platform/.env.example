# ============================================
# VOIA — Environment Config (BYOK)
# ============================================
# Copy:  cp voice_platform/.env.example voice_platform/.env
# Check: python scripts/check_setup.py
#
# Tiers:
#   0 Playground — ALLOW_DEV_LOGIN + one LLM key (no Twilio)
#   1 Live call  — Tier 0 + Twilio + Deepgram (+ BASE_URL/ngrok)
#   2 Full ops   — Tier 1 + integration OAuth as needed

# ── Auth (Tier 0) ────────────────────────────
# Local dashboard login without Google. NEVER enable in production.
ALLOW_DEV_LOGIN=true

# ── Server ───────────────────────────────────
# Leave empty to auto-create ngrok tunnel (Tier 1)
BASE_URL=
# ngrok auth token — https://dashboard.ngrok.com (Tier 1 if BASE_URL empty)
NGROK_AUTH_TOKEN=

# ── LLM (Tier 0 — at least one) ──────────────
# OpenRouter (default path for many agents)
OPENROUTER_API_KEY=
# Or Groq / OpenAI / Gemini / Ollama-compatible:
# GROQ_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_BASE=http://localhost:11434/v1
# COMMANDCODE_API_KEY=
# Anthropic via OpenRouter: set OpenRouter key here
# ANTHROPIC_API_KEY=sk-or-v1-...

# ── STT (Tier 1) ─────────────────────────────
DEEPGRAM_API_KEY=

# ── TTS (optional) ───────────────────────────
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastus
# ELEVENLABS_API_KEY=

# ── Twilio (Tier 1) ──────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
REQUIRE_TWILIO_WEBHOOK_SIGNATURE=false
VALIDATE_TWILIO_WEBHOOK_IF_PRESENT=true
ALLOW_PLATFORM_TWILIO_FALLBACK_FOR_CAMPAIGNS=false

# ── Redis ────────────────────────────────────
# Host access when Compose maps 6380→6379:
REDIS_URL=redis://localhost:6380
# Inside Compose app container this is overridden to redis://redis:6379

# ── Platform Defaults ────────────────────────
DEFAULT_LLM_MODEL=deepseek/deepseek-v4-flash
LOG_LEVEL=DEBUG

# ── Google OAuth (optional if ALLOW_DEV_LOGIN) ─
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/oauth/google/callback

# ── JWT ──────────────────────────────────────
# Required for production / any host with ALLOW_DEV_LOGIN=false (≥32 chars).
# For local Tier 0 with ALLOW_DEV_LOGIN=true, leave empty to get an ephemeral
# per-process secret (tokens reset on restart), or set a stable local value:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ── Encryption ───────────────────────────────
# Fernet key for API keys at rest. Prefer an explicit key in production.
# If unset, derived from JWT_SECRET (+ local salt file, gitignored).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# ── CORS ─────────────────────────────────────
CORS_ALLOWED_ORIGINS=*

# ── Database ─────────────────────────────────
# Default without DATABASE_URL: SQLite (voice_platform/voia.db)
# Host access when Compose maps 5433→5432 (local default password):
# DATABASE_URL=postgresql+asyncpg://voia:voia_password@localhost:5433/voia
# Production compose requires POSTGRES_PASSWORD in the environment and
# does not allow ALLOW_DEV_LOGIN.
